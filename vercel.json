{
  "version": 2,
  "framework": null,
  "buildCommand": "cp -r src/web/public/. public/ && mv public/index.html public/app.html",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/", "destination": "/landing.html" }
  ]
}
