{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    }
  ]
}
