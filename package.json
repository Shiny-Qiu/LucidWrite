{
  "name": "edit-ai",
  "version": "0.0.24",
  "description": "Local AI writing workspace for multi-agent content creation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "newtype-profile": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./google-auth": {
      "types": "./dist/google-auth.d.ts",
      "import": "./dist/google-auth.js"
    },
    "./schema.json": "./dist/oh-my-opencode.schema.json"
  },
  "scripts": {
    "build": "bun run build:editor && bun build src/index.ts src/google-auth.ts src/web/server.ts --outdir dist --target bun --format esm --external @ast-grep/napi && rm -rf dist/public && cp -R src/web/public dist/public && tsc --emitDeclarationOnly && bun build src/cli/index.ts --outdir dist/cli --target bun --format esm --external @ast-grep/napi && bun run build:schema",
    "build:schema": "bun run script/build-schema.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "web": "bun run build:editor && bun run src/web/server.ts",
    "test:web": "bun run build:editor && bun test tests/web",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "build:web": "npm run typecheck:web && node script/build-web.mjs",
    "build:editor": "node script/build-editor.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "content-creation",
    "ai-agents",
    "knowledge-base",
    "writing",
    "research",
    "ai",
    "llm"
  ],
  "author": "huangyihe",
  "license": "SUL-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pengcong2020520/edit-ai.git"
  },
  "bugs": {
    "url": "https://github.com/pengcong2020520/edit-ai/issues"
  },
  "homepage": "https://github.com/pengcong2020520/edit-ai#readme",
  "dependencies": {
    "@ast-grep/cli": "^0.40.0",
    "@ast-grep/napi": "^0.40.0",
    "@clack/prompts": "^0.11.0",
    "@code-yeongyu/comment-checker": "^0.6.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@openauthjs/openauth": "^0.4.3",
    "@opencode-ai/plugin": "^1.1.1",
    "@opencode-ai/sdk": "^1.1.1",
    "@supabase/supabase-js": "^2.49.8",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "commander": "^14.0.2",
    "dompurify": "^3.4.15",
    "hono": "^4.10.4",
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.2",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/picomatch": "^3.0.2",
    "bun-types": "latest",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "typescript": "^5.7.3"
  },
  "trustedDependencies": [
    "@ast-grep/cli",
    "@ast-grep/napi",
    "@code-yeongyu/comment-checker"
  ]
}
